+    private static void animateChildScale(ModelPart parent, String name, float x, float y, float z) {
+        if (!parent.hasChild(name)) return;
+        ModelPart part = parent.getChild(name);
+        part.xScale = x;
+        part.yScale = y;
+        part.zScale = z;
+    }
+
+    private static void animateChildOffset(ModelPart parent, String name, float x, float y, float z) {
+        if (!parent.hasChild(name)) return;
+        ModelPart part = parent.getChild(name);
+        part.x = x;
+        part.y = y;
+        part.z = z;
+    }
+
+    private static void animateChildRoll(ModelPart parent, String name, float roll) {
+        if (!parent.hasChild(name)) return;
+        parent.getChild(name).zRot = roll;
+    }
+
+    private static void animateChildYaw(ModelPart parent, String name, float yaw) {
+        if (!parent.hasChild(name)) return;
+        parent.getChild(name).yRot = yaw;
+    }
+
+    private enum ArmorMotion {
+        PHASEWEAVE, CAUSAL, SOVEREIGN
+    }
