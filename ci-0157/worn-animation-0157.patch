+    /**
+     * Autonomous client-side motion for the worn armor geometry itself. Inventory sprites already
+     * animate separately; this pass makes the custom equipped silhouettes visibly alive as well.
+     *
+     * <p>NeoForge 26.2's {@code setupModelAnimations} hook is intentionally not wired into the
+     * equipment renderer yet, so animation is applied here during the per-layer model query. Every
+     * transform is assigned from an absolute time sample rather than accumulated, preventing drift
+     * across repeated equipment layers or multiple rendered players.</p>
+     */
+    private static void applyWornAnimation(HumanoidModel<HumanoidRenderState> model, ArmorMotion motion) {
+        double t = System.nanoTime() * 1.0E-9D;
+        float slow = (float) Math.sin(t * 1.35D);
+        float medium = (float) Math.sin(t * 2.10D);
+        float counter = (float) Math.sin(t * 1.70D + Math.PI * 0.5D);
+
+        switch (motion) {
+            case PHASEWEAVE -> {
+                animateChildScale(model.head, "phaseweave_visor", 1.0F + 0.018F * medium, 1.0F, 1.0F + 0.055F * medium);
+                animateChildOffset(model.head, "phaseweave_crownrail", 0.0F, -0.06F - 0.06F * slow, 0.0F);
+                animateChildRoll(model.leftArm, "phaseweave_shoulder_fin", 0.035F + 0.045F * counter);
+                animateChildRoll(model.rightArm, "phaseweave_shoulder_fin", -0.035F - 0.045F * counter);
+                animateChildScale(model.leftLeg, "phaseweave_knee", 1.0F + 0.025F * slow, 1.0F, 1.0F);
+                animateChildScale(model.rightLeg, "phaseweave_knee", 1.0F - 0.025F * slow, 1.0F, 1.0F);
+            }
+            case CAUSAL -> {
+                animateChildYaw(model.head, "causal_temporal_ridge", 0.040F * slow);
+                animateChildOffset(model.head, "causal_brow", 0.0F, -0.035F - 0.035F * medium, 0.0F);
+                animateChildScale(model.body, "causal_breastplate", 1.0F + 0.018F * counter, 1.0F + 0.025F * counter, 1.0F);
+                animateChildRoll(model.leftArm, "veilbound_pauldron", 0.045F + 0.060F * slow);
+                animateChildRoll(model.rightArm, "veilbound_pauldron", -0.045F - 0.060F * slow);
+                animateChildScale(model.leftLeg, "veilbound_shin", 1.0F, 1.0F + 0.020F * medium, 1.0F);
+                animateChildScale(model.rightLeg, "veilbound_shin", 1.0F, 1.0F - 0.020F * medium, 1.0F);
+            }
+            case SOVEREIGN -> {
+                // The crown subtly floats while the regulator and worldline plate breathe out of phase.
+                animateChildOffset(model.head, "sovereign_crown", 0.0F, -0.10F - 0.10F * slow, 0.0F);
+                animateChildYaw(model.head, "sovereign_crown", 0.028F * counter);
+                animateChildScale(model.body, "sovereign_regulator", 1.0F + 0.025F * medium, 1.0F + 0.035F * medium, 1.0F + 0.055F * medium);
+                animateChildScale(model.body, "sovereign_worldline_back", 1.0F + 0.035F * counter, 1.0F + 0.020F * counter, 1.0F);
+                animateChildRoll(model.leftArm, "veilbound_pauldron", 0.070F + 0.075F * counter);
+                animateChildRoll(model.rightArm, "veilbound_pauldron", -0.070F - 0.075F * counter);
+                animateChildYaw(model.leftArm, "sovereign_forearm", 0.030F * medium);
+                animateChildYaw(model.rightArm, "sovereign_forearm", -0.030F * medium);
+                animateChildScale(model.leftLeg, "veilbound_shin", 1.0F + 0.022F * slow, 1.0F, 1.0F + 0.018F * slow);
+                animateChildScale(model.rightLeg, "veilbound_shin", 1.0F - 0.022F * slow, 1.0F, 1.0F - 0.018F * slow);
+            }
+        }
+    }
