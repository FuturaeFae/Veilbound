+        int trackHeight = h - (SCROLL_ARROW * 2) - 4;
+        int thumb = Math.max(12, trackHeight / pages);
+        int travel = Math.max(1, trackHeight - thumb);
+        int pointer = Math.max(0, Math.min(travel, mouseY - trackStart - thumb / 2));
+        int page = (int) Math.round((double) pointer * (pages - 1) / travel);
+        goToPage(page);
+        return true;
+    }
