+    @Override
+    public boolean mouseClicked(MouseButtonEvent event, boolean doubleClick) {
+        // Explicit widgets (search, sort, mode, clear, paging) get first chance at the event.
+        if (super.mouseClicked(event, doubleClick)) return true;
+        if (!snapshot.allowed()) return false;
+
+        int mouseX = (int) event.x();
+        int mouseY = (int) event.y();
+
+        // Storage/result grid: virtual withdrawal/selection cells, never rearrangeable slots.
+        int gridCell = gridCellAt(mouseX, mouseY);
+        if (gridCell >= 0) {
+            if (mode == Mode.INVENTORY) {
+                // The storage grid is a withdrawal browser, not a second movable inventory. Do not
+                // reinterpret a click while the player is already carrying a vanilla inventory stack.
+                if (!carriedStack().isEmpty()) return true;
+                if (gridCell < snapshot.entries().size() && (event.button() == 0 || event.button() == 1)) {
+                    withdraw(snapshot.entries().get(gridCell).resource(), event.button() == 1);
+                    return true;
+                }
+            } else if (gridCell < craftables.entries().size() && event.button() == 0) {
+                selectRecipe(gridCell);
+                return true;
+            }
+        }
+
+        int inventorySlot = playerInventorySlotAt(mouseX, mouseY);
+        if (inventorySlot >= 0 && (event.button() == 0 || event.button() == 1)) {
+            return handlePlayerInventoryClick(inventorySlot, event, doubleClick);
+        }
+
+        if (mode == Mode.CRAFTING) {
+            int cell = craftingCellAt(mouseX, mouseY);
+            if (cell >= 0 && event.button() == 0) {
+                craftingCellClicked(cell);
+                return true;
+            }
+            int side = sideLeft();
+            int top = sideTop();
+            if (inside(mouseX, mouseY, side + 25, top + 84, SLOT, SLOT) && event.button() == 0) {
+                if (craftingPreview.craftable()) {
+                    sendCraft(event.hasShiftDown()
+                            ? VeilCraftingRequestPayload.Action.CRAFT_MAX
+                            : VeilCraftingRequestPayload.Action.CRAFT_ONCE);
+                }
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private int gridCellAt(int mouseX, int mouseY) {
+        if (!inside(mouseX, mouseY, gridLeft(), gridTop(), GRID_COLUMNS * SLOT, GRID_ROWS * SLOT)) return -1;
+        int col = (mouseX - gridLeft()) / SLOT;
+        int row = (mouseY - gridTop()) / SLOT;
+        return row * GRID_COLUMNS + col;
+    }
+
+    private int playerInventorySlotAt(int mouseX, int mouseY) {
+        if (inside(mouseX, mouseY, gridLeft(), playerGridTop(), 9 * SLOT, 3 * SLOT)) {
+            int col = (mouseX - gridLeft()) / SLOT;
+            int row = (mouseY - playerGridTop()) / SLOT;
+            return 9 + row * 9 + col;
+        }
+        if (inside(mouseX, mouseY, gridLeft(), hotbarTop(), 9 * SLOT, SLOT)) {
+            return (mouseX - gridLeft()) / SLOT;
+        }
+        return -1;
+    }
+
+    private int craftingCellAt(int mouseX, int mouseY) {
+        int side = sideLeft();
+        int top = sideTop();
+        int x = side + 7;
+        int y = top + 22;
+        if (!inside(mouseX, mouseY, x, y, 3 * SLOT, 3 * SLOT)) return -1;
+        return ((mouseY - y) / SLOT) * 3 + ((mouseX - x) / SLOT);
     }
 
