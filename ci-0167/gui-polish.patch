+    private static int playerInventoryMenuSlot(int inventorySlot) {
+        if (inventorySlot >= 0 && inventorySlot < 9) return 36 + inventorySlot;
+        if (inventorySlot >= 9 && inventorySlot < 36) return inventorySlot;
+        return -1;
+    }
